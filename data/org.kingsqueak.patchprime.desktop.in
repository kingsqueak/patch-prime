[Desktop Entry]
Type=Application
Name=Patch Prime
GenericName=Audio Mixer
Comment=Mix and route audio between devices and apps
Exec=@CMAKE_INSTALL_FULL_BINDIR@/patchprime
Icon=audio-card
Terminal=false
Categories=AudioVideo;Audio;Mixer;Qt;KDE;
Keywords=mixer;audio;routing;pipewire;stream;
StartupNotify=true
