[Desktop Entry]
Type=Application
Name=Patch Prime Tray
Comment=The microphone's mute and quick mixer controls in the system tray
Exec=patchprime-tray
Icon=org.kingsqueak.patchprime
NoDisplay=true
X-KDE-autostart-phase=2
X-GNOME-Autostart-enabled=true
