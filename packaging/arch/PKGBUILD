# Arch Linux package: `makepkg -si` in this directory. Builds the release
# tarball; RNNoise (for noise suppression) and the CLAP and VST3 headers are sources
# here rather than fetched while building. Keep pkgver in step with CMakeLists.txt.

pkgname=patchprime
pkgver=0.12
pkgrel=1
pkgdesc="Virtual audio mixer and router for KDE Plasma on PipeWire"
arch=(x86_64 aarch64)
url="https://github.com/kingsqueak/patch-prime"
license=(GPL-3.0-or-later)
depends=(glibc gcc-libs libpipewire libsndfile lilv libx11 alsa-lib pipewire wireplumber qt6-base qt6-declarative
         kirigami kdeclarative qqc2-desktop-style)
makedepends=(cmake ninja lv2)
install=patchprime.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
        "https://github.com/xiph/rnnoise/releases/download/v0.2/rnnoise-0.2.tar.gz"
        "clap-1.2.10.tar.gz::https://github.com/free-audio/clap/archive/refs/tags/1.2.10.tar.gz"
        "vst3_pluginterfaces-3.8.0.tar.gz::https://github.com/steinbergmedia/vst3_pluginterfaces/archive/refs/tags/v3.8.0_build_66.tar.gz")
sha256sums=('49516ff105684293ba4596b285bf8befa397ef2af43a394647476ee5e5053057'
            '90fce4b00b9ff24c08dbfe31b82ffd43bae383d85c5535676d28b0a2b11c0d37'
            '58fdb977c6678859c15d57942378b651399178f49a3a8ecad1813b9f231dc096'
            'c922f0a35f2c093dfcb24ccd95282e70d00cc2de42fc0c8ac1577398ffe7b6d4')

build() {
    cmake -B build -S "patch-prime-$pkgver" -G Ninja -Wno-dev \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DPATCHPRIME_SYSTEMD_USER_UNIT_DIR=lib/systemd/user \
        -DFETCHCONTENT_SOURCE_DIR_RNNOISE="$srcdir/rnnoise-0.2" \
        -DFETCHCONTENT_SOURCE_DIR_CLAP="$srcdir/clap-1.2.10" \
        -DFETCHCONTENT_SOURCE_DIR_VST3PLUGINTERFACES="$srcdir/vst3_pluginterfaces-3.8.0_build_66"
    cmake --build build
}

check() {
    # The live tests need a running PipeWire server.
    QT_QPA_PLATFORM=offscreen ctest --test-dir build --output-on-failure -LE pipewire
}

package() {
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 "patch-prime-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname"
}
